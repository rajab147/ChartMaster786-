    # صرف وہی کوائنز رکھیں جو بائننس اسپاٹ/فیوچرز پر موجود ہیں
]

def get_signal(symbol):
    try:
        url = f"https://api.binance.com/api/v3/ticker/24hr?symbol={symbol}"
        response = requests.get(url, timeout=10)
        
        # اگر بائننس ایرر دے تو یہاں سے واپس ہو جائے
        if response.status_code != 200:
            return None
            
        data = response.json()
        price = float(data['lastPrice'])
        change = float(data['priceChangePercent'])
        
        signal_type = ""
        entry_reason = ""
        
        if change > 3.5: 
            signal_type = "🔴 SELL/SHORT"
            entry_reason = "SMC Liquidity Grab"
            tp = price * 0.985  
            sl = price * 1.01   
        elif change < -3.5: 
            signal_type = "🟢 BUY/LONG"
            entry_reason = "FVG Test & MSS"
            tp = price * 1.015  
            sl = price * 0.99   
            
        if signal_type:
            return (f"🚀 **ChartMaster786 VIP SIGNAL**\n"
                    f"🪙 **Coin:** {symbol}\n"
                    f"📈 **Action:** {signal_type}\n"
                    f"💰 **Entry:** ${price:,.4f}\n"
                    f"🎯 **Target (TP):** ${tp:,.4f}\n"
                    f"🛡️ **Stop Loss (SL):** ${sl:,.4f}\n"
                    f"📝 **Reason:** {entry_reason}")
    except Exception as e:
        print(f"Error fetching {symbol}: {e}")
        return None

print("ChartMaster786 Cloud Bot is starting...")

while True:
    try:
        for coin in COINS:
            message = get_signal(coin)
            if message:
                requests.post(WEBHOOK_URL, json={"content": message})
                print(f"Signal sent for {coin}")
                time.sleep(2) 
        
        print("Scan complete. Waiting 10 minutes...")
        time.sleep(600)
    except Exception as e:
        print(f"Main loop error: {e}")
        time.sleep(60) # ایرر کی صورت میں ایک منٹ رک کر دوبارہ کوشش کرے گا
