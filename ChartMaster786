WEBHOOK_URL = "https://discord.com/api/webhooks/1501860120529731626/HZKSmLYjlAP43thhbcZRYR5b93nNKDfjrQUBaSCrmP1ulQDn-tGK5m-TgzfuIMay5yFb"

COINS = [
    "BTCUSDT", "ETHUSDT", "SOLUSDT", "ICPUSDT", 
